{
  "name": "remote-fs-node",
  "version": "1.0.5",
  "description": "Node.js fs-compatible module backed by HTTP. Drop-in replacement for require('fs') that routes all operations to a remote server via process.binding('fs') interception.",
  "main": "index.js",
  "files": ["index.js", "lib/"],
  "scripts": {
    "test": "node test/test.js",
    "test:adv": "node test/test_adversarial.js",
    "test:all": "node test/test.js && node test/test_adversarial.js"
  },
  "keywords": [
    "fs",
    "remote",
    "http",
    "ssh",
    "sftp",
    "agent",
    "drop-in",
    "mock-fs",
    "binding",
    "cloud"
  ],
  "author": "tastypear",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tastypear/remote-fs-node"
  },
  "peerDependencies": {},
  "devDependencies": {
    "fs-extra": "^11.0.0",
    "graceful-fs": "^4.2.0",
    "glob": "^10.0.0"
  }
}
